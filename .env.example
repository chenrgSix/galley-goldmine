# Optional local workspace override
# GOLDMINE_HOME=/absolute/path/to/goldmine

# Compose dashboard settings
# Set a password of at least 12 characters for the admin account
# GOLDMINE_ADMIN_PASSWORD=
# GOLDMINE_GALLEY_URL=https://blog.example.com
# GOLDMINE_WEB_PORT=8787

# Optional HTTPS origin if using a reverse proxy
# GOLDMINE_WEB_ORIGIN=https://goldmine.example.com

# Wechatsync bridge settings
# WECHATSYNC_TOKEN=
# GOLDMINE_BRIDGE_PORT=9527
